# highnet-rag configuration. Copy to .env for local development; on Fly.io set the secrets
# with `fly secrets set` and the rest in fly.toml [env]. Defaults are shown; every variable
# is read and validated in api/src/highnet_rag/config.py.

# --- Providers (secrets) -----------------------------------------------------------------
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
# Salt for hashing visitor IPs before they are stored (secret; any long random string).
IP_HASH_SALT=change-me

# Offline stand-ins (hashed word vectors + extractive "LLM"). No keys, no cost, illustrative
# output only. Use with `highnet-rag ingest --fake` for a fully local run.
FAKE_PROVIDERS=false

# --- Models -------------------------------------------------------------------------------
CLAUDE_MODEL_DEFAULT=claude-haiku-4-5
CLAUDE_MODEL_DEMO=claude-opus-5
CLAUDE_MODEL_JUDGE=claude-sonnet-5
# true = answer with CLAUDE_MODEL_DEMO instead of CLAUDE_MODEL_DEFAULT (for recorded demos).
DEMO_MODE=false
MAX_ANSWER_TOKENS=1024

VOYAGE_BASE_URL=https://api.voyageai.com/v1
VOYAGE_EMBED_MODEL=voyage-3.5-lite
VOYAGE_RERANK_MODEL=rerank-2.5-lite
EMBED_DIMS=1024

# --- Storage ------------------------------------------------------------------------------
CORPUS_DB_PATH=data/corpus.sqlite
STATE_DB_PATH=data/state.sqlite
# Built Next.js export served at /. Build it with `npm run build` in web/.
STATIC_DIR=web/out

# --- Budget and rate limits ---------------------------------------------------------------
BUDGET_MONTHLY_USD=20
# Fraction of the cap at which expensive features switch off.
BUDGET_DEGRADE_AT=0.8
RATE_LIMIT_PER_MIN=20
RATE_LIMIT_PER_DAY=200
# JSON map of model -> USD per 1M tokens, overriding api/src/highnet_rag/pricing.py.
# PRICE_OVERRIDES={"claude-haiku-4-5": {"input": 1.0, "output": 5.0}}

# --- Query limits -------------------------------------------------------------------------
MAX_QUERY_CHARS=500
DEFAULT_TOP_K=5
MAX_TOP_K=10
AGENT_MAX_STEPS=4

# --- Cross-origin access (web on Vercel, API on Fly) ---------------------------------------
# Comma-separated exact origins allowed to call the API, e.g. the Vercel production domain
# and `next dev`. Preview deployments are matched by CORS_ORIGIN_REGEX.
CORS_ORIGINS=http://localhost:3000
# CORS_ORIGIN_REGEX=^https://highnet-[a-z0-9-]+-highnets-projects\.vercel\.app$

# --- Frontend (Vercel project env / web/.env.local) -----------------------------------------
# Where the browser finds the API. Empty = same origin (local `highnet-rag serve` with web/out).
# NEXT_PUBLIC_API_BASE=https://highnet-rag.fly.dev
